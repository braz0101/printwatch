# Copier en .env (chmod 600), ne jamais versionner.
PRINTWATCH_SNMP_AUTH_PASS=
PRINTWATCH_SNMP_PRIV_PASS=
# Test initial en v2c uniquement :
# PRINTWATCH_SNMP_COMMUNITY=
# PRINTWATCH_SMTP_PASSWORD=
# Code administrateur du dashboard : requis pour modifier les imprimantes hors boucle locale (serveur exposé).
# PRINTWATCH_ADMIN_TOKEN=
# Noms d'hôte acceptés dans l'en-tête Host (anti « rebinding DNS »). En local : localhost / 127.0.0.1 sont toujours acceptés.
# Derrière un proxy inverse, déclarer le nom public, par exemple : printwatch.exemple.sn
# PRINTWATCH_ALLOWED_HOSTS=
